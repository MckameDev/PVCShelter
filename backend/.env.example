# Copia este archivo como .env y completa tus valores. El .env NO se sube al repositorio.

# development | production (en production nunca se muestran detalles de errores)
APP_ENV=development

# Base de datos MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pvc_shelter
DB_USER=
DB_PASS=

# Cookie de sesión. En producción con HTTPS pon SESSION_SECURE=true.
SESSION_SECURE=false
SESSION_LIFETIME_DAYS=30

# Tamaño máximo de una partida guardada (bytes). 2 MB por defecto.
MAX_SAVE_BYTES=2097152
